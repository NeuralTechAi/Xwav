{
  "name": "xvaw-vscode",
  "displayName": "Xvaw",
  "description": "Open your running local Xvaw server inside VS Code, in an editor-beside iframe.",
  "version": "0.1.0",
  "publisher": "neuraltechai",
  "license": "Apache-2.0",
  "icon": "media/xvaw-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeuralTechAi/Xvaw.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "Xvaw",
      "properties": {
        "xvaw.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Manual Xvaw server URL override for a **localhost** server (e.g. `http://127.0.0.1:6767`). Leave empty to auto-discover a locally running Xvaw server. Non-localhost URLs are not supported in this build."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xvaw-container",
          "title": "Xvaw",
          "icon": "media/xvaw-icon.svg"
        }
      ]
    },
    "views": {
      "xvaw-container": [
        {
          "type": "tree",
          "id": "xvaw.home",
          "name": "Xvaw"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "xvaw.home",
        "contents": "Open the running Xvaw server UI in an editor tab.\n[Open Xvaw](command:xvaw.open)\nStart a local server with `xvaw server`, or set `xvaw.serverUrl` to a localhost URL."
      }
    ],
    "commands": [
      {
        "command": "xvaw.open",
        "title": "Xvaw: Open",
        "icon": "media/xvaw-icon.svg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xvaw.open",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "xvaw.open"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5",
    "vitest": "^3.2.6"
  }
}
