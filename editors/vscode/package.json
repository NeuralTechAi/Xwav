{
  "name": "xwav-vscode",
  "displayName": "Xwav",
  "description": "Open your running local Xwav server inside VS Code, in an editor-beside iframe.",
  "version": "0.1.0",
  "publisher": "neuraltechai",
  "license": "Apache-2.0",
  "icon": "media/xwav-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeuralTechAi/Xwav.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "Xwav",
      "properties": {
        "xwav.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Manual Xwav server URL override for a **localhost** server (e.g. `http://127.0.0.1:6767`). Leave empty to auto-discover a locally running Xwav server. Non-localhost URLs are not supported in this build."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xwav-container",
          "title": "Xwav",
          "icon": "media/xwav-icon.svg"
        }
      ]
    },
    "views": {
      "xwav-container": [
        {
          "type": "tree",
          "id": "xwav.home",
          "name": "Xwav"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "xwav.home",
        "contents": "Open the running Xwav server UI in an editor tab.\n[Open Xwav](command:xwav.open)\nStart a local server with `xwav server`, or set `xwav.serverUrl` to a localhost URL."
      }
    ],
    "commands": [
      {
        "command": "xwav.open",
        "title": "Xwav: Open",
        "icon": "media/xwav-icon.svg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xwav.open",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "xwav.open"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5",
    "vitest": "^3.2.6"
  }
}
