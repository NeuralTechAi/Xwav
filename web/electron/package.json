{
  "name": "xvaw-desktop-electron",
  "productName": "Xvaw",
  "version": "0.18.1",
  "description": "Xvaw desktop \u2014 your agents, one workspace.",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://github.com/NeuralTechAi/Xvaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeuralTechAi/Xvaw.git"
  },
  "author": {
    "name": "NeuralTechAi"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build": "electron-builder -c.appId=ai.neuraltech.xvaw.desktop-dev -c.productName='Xvaw Dev' -c.directories.output=dist-dev -c.extraMetadata.omnigentBuild=dev",
    "build:mac": "electron-builder --mac -c.appId=ai.neuraltech.xvaw.desktop-dev -c.productName='Xvaw Dev' -c.directories.output=dist-dev -c.extraMetadata.omnigentBuild=dev",
    "build:mac:release": "OMNIGENT_NOTARIZE_DMG=true electron-builder --mac -c.mac.notarize=true -c.dmg.sign=true",
    "build:linux": "electron-builder --linux -c.appId=ai.neuraltech.xvaw.desktop-dev -c.productName='Xvaw Dev' -c.directories.output=dist-dev -c.extraMetadata.omnigentBuild=dev",
    "build:win": "electron-builder --win -c.appId=ai.neuraltech.xvaw.desktop-dev -c.productName='Xvaw Dev' -c.directories.output=dist-dev -c.extraMetadata.omnigentBuild=dev",
    "build:overlay": "pnpm --filter web run build:overlay && pnpm --filter web run build:server-selector-v2",
    "predev": "pnpm run build:overlay",
    "prestart": "pnpm run build:overlay",
    "prebuild": "pnpm run build:overlay",
    "prebuild:mac": "pnpm run build:overlay",
    "prebuild:mac:release": "pnpm run build:overlay",
    "prebuild:linux": "pnpm run build:overlay",
    "prebuild:win": "pnpm run build:overlay"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "ai.neuraltech.xvaw.desktop",
    "productName": "Xvaw",
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Xvaw session link",
        "schemes": [
          "omnigent"
        ]
      }
    ],
    "publish": null,
    "afterPack": "build/afterPack.js",
    "afterAllArtifactBuild": "build/afterAllArtifactBuild.js",
    "files": [
      "src/**/*",
      "about/**/*",
      "browser-permission/**/*",
      "workspace-picker/**/*",
      "setup/**/*",
      "arca-connect/**/*",
      "server-selector-v2/**/*",
      "find/**/*",
      "return-banner/**/*",
      "connection-loading/**/*",
      "reconnect-overlay/**/*",
      "icons/**/*",
      "overlay/**/*"
    ],
    "extraResources": [
      {
        "from": "../platform-assets",
        "to": "platform-assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../scripts/install_oss.sh",
        "to": "install_oss.sh"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/icon.icns",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Xvaw uses the microphone for voice dictation in the message composer.",
        "NSPrefersDisplaySafeAreaCompatibilityMode": false
      },
      "gatekeeperAssess": false,
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "publish": null
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "background": "dmg/background.tiff",
      "window": {
        "width": 640,
        "height": 465
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 170,
          "y": 100
        },
        {
          "x": 470,
          "y": 100,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "icons/icon.svg",
      "category": "Development",
      "maintainer": "NeuralTechAi",
      "target": [
        "AppImage",
        "deb"
      ],
      "publish": null
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis"
      ],
      "publish": null
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.3.2"
  }
}
