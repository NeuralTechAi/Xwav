# Small source overlay; reuse preinstalled clients and tools across jobs.
ARG BASE_IMAGE=xwav-host:local
FROM ${BASE_IMAGE}
USER root
COPY omnigent /tmp/xwav-runtime
RUN python -c "import omnigent, pathlib, shutil; shutil.copytree('/tmp/xwav-runtime', pathlib.Path(omnigent.__file__).parent, dirs_exist_ok=True)" \
 && rm -rf /tmp/xwav-runtime
USER sandbox
